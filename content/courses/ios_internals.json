                "Taurine",
                "Fugu"
              ],
              "id": "ios_internals_21"
            },
            {
              "type": "mathChoice",
              "question": "A jailbreak that leaves the system partition untouched is",
              "answer": "Rootless",
              "choices": [
                "Rootless",
                "Rootful",
                "Tethered",
                "Semi-tethered"
              ],
              "id": "ios_internals_22"
            },
            {
              "type": "mathChoice",
              "question": "Blobs saved to allow downgrading firmware",
              "answer": "SHSH blobs",
              "choices": [
                "SHSH blobs",
                "IPSW files",
                "Entitlements",
                "Provisioning profiles"
              ],
              "id": "ios_internals_23"
            }
          ]
        },
        {
          "id": "u1l5",
          "title": "Research practice",
          "exercises": [
            {
              "type": "mathChoice",
