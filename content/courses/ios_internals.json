{
  "id": "ios_internals",
  "name": "iOS Internals & Jailbreaks",
  "category": "programming",
  "icon": "fa-solid fa-mobile-screen-button",
  "level": "Intermediate",
  "version": 1,
  "units": [
    {
      "id": "u1",
      "title": "All",
      "lessons": [
        {
          "id": "u1l1",
          "title": "iOS security model",
          "exercises": [
            {
              "type": "mathChoice",
              "question": "The chain that verifies each boot stage from ROM upward",
              "answer": "Secure Boot Chain",
              "choices": [
                "Secure Boot Chain",
                "Keychain",
                "Sandbox",
                "Gatekeeper"
              ],
              "id": "ios_internals_0"
            },
            {
              "type": "mathChoice",
              "question": "Immutable first-stage bootloader burned into the SoC",
              "answer": "BootROM",
              "choices": [
                "BootROM",
                "iBoot",
                "LLB",
                "XNU"
              ],
              "id": "ios_internals_1"
            },
            {
              "type": "mathChoice",
              "question": "Name of the iOS/macOS kernel",
              "answer": "XNU",
              "choices": [
                "XNU",
                "Linux",
                "Mach",
                "Darwin"
              ],
              "id": "ios_internals_2"
            },
            {
              "type": "mathChoice",
              "question": "Per-app restriction on file and API access",
              "answer": "Sandbox",
              "choices": [
                "Sandbox",
                "Entitlements",
                "Codesign",
                "KPP"
              ],
              "id": "ios_internals_3"
            },
            {
              "type": "mathChoice",
              "question": "Signed key-value permissions baked into an app binary",
              "answer": "Entitlements",
              "choices": [
                "Entitlements",
                "Provisioning",
                "Sandbox",
                "Keychain"
              ],
              "id": "ios_internals_4"
            },
            {
              "type": "mathChoice",
              "question": "Requirement that all executable pages be signed",
              "answer": "Code signing enforcement",
              "choices": [
                "Code signing enforcement",
                "ASLR",
                "PAC",
                "SIP"
              ],
              "id": "ios_internals_5"
            }
          ]
        },
        {
          "id": "u1l2",
          "title": "Jailbreak anatomy",
          "exercises": [
            {
              "type": "mathChoice",
              "question": "A jailbreak fundamentally needs to defeat",
              "answer": "Code signing and the sandbox",
              "choices": [
                "Code signing and the sandbox",
                "The App Store",
                "iCloud",
                "Face ID"
              ],
              "id": "ios_internals_6"
            },
            {
              "type": "mathChoice",
              "question": "A jailbreak that survives reboot is called",
              "answer": "Untethered",
              "choices": [
                "Untethered",
                "Tethered",
                "Semi-tethered",
                "Rootless"
              ],
              "id": "ios_internals_7"
            },
            {
              "type": "mathChoice",
              "question": "A jailbreak needing a computer at each boot is",
              "answer": "Tethered",
              "choices": [
                "Tethered",
                "Untethered",
                "Semi-untethered",
                "Rootless"
              ],
              "id": "ios_internals_8"
            },
            {
              "type": "mathChoice",
              "question": "A jailbreak re-run by opening an app after reboot is",
              "answer": "Semi-untethered",
              "choices": [
                "Semi-untethered",
                "Untethered",
                "Tethered",
                "Rootful"
              ],
              "id": "ios_internals_9"
            },
            {
              "type": "mathChoice",
              "question": "checkm8 exploits a bug in",
              "answer": "The BootROM",
              "choices": [
                "The BootROM",
                "The kernel",
                "WebKit",
                "Safari"
              ],
              "id": "ios_internals_10"
            },
            {
              "type": "mathChoice",
              "question": "Why can Apple not patch checkm8 on affected devices?",
              "answer": "BootROM is read-only",
              "choices": [
                "BootROM is read-only",
                "Apple chose not to",
                "It is in hardware fuses",
                "It needs a recall"
              ],
              "id": "ios_internals_11"
            }
          ]
        },
        {
          "id": "u1l3",
          "title": "Exploit chains",
          "exercises": [
            {
              "type": "mathChoice",
              "question": "First stage of a typical chain gets you",
              "answer": "Code execution in a user process",
              "choices": [
                "Code execution in a user process",
                "Kernel read/write",
                "A root shell",
                "A signed binary"
              ],
              "id": "ios_internals_12"
            },
            {
              "type": "mathChoice",
              "question": "The prize of the kernel stage is usually",
              "answer": "Arbitrary kernel read/write",
              "choices": [
                "Arbitrary kernel read/write",
                "A crash log",
                "A sandbox escape",
                "A UI hook"
              ],
              "id": "ios_internals_13"
            },
            {
              "type": "mathChoice",
              "question": "Escaping the browser process to attack the kernel is",
              "answer": "A sandbox escape",
              "choices": [
                "A sandbox escape",
                "Privilege escalation",
                "Persistence",
                "Injection"
              ],
              "id": "ios_internals_14"
            },
            {
              "type": "mathChoice",
              "question": "Reusing existing code snippets to bypass NX is",
              "answer": "ROP",
              "choices": [
                "ROP",
                "JOP only",
                "Shellcode",
                "Heap spray"
              ],
              "id": "ios_internals_15"
            },
            {
              "type": "mathChoice",
              "question": "Apple hardware feature signing pointers to stop ROP",
              "answer": "PAC",
              "choices": [
                "PAC",
                "KPP",
                "KTRR",
                "SIP"
              ],
              "id": "ios_internals_16"
            },
            {
              "type": "mathChoice",
              "question": "Hardware protection making kernel text read-only after boot",
              "answer": "KTRR",
              "choices": [
                "KTRR",
                "PAC",
                "ASLR",
                "SIP"
              ],
              "id": "ios_internals_17"
            }
          ]
        },
        {
          "id": "u1l4",
          "title": "Tooling and history",
          "exercises": [
            {
